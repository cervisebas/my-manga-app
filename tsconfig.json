{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["./src/api/*"],
      "@libs/*": ["./src/common/libs/*"],
      "@database/*": ["./src/database/*"],
      "@modules/*": ["./modules/*"],
      "@drizzle/*": ["./drizzle/*"]
    },
    "experimentalDecorators": true
  }
}
